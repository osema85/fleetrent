# =====================================================================
# FleetRent — environment template
#
# Do NOT put real secrets in this file. Create your private .env with:
#     ./scripts/generate-env.sh
# .env is gitignored and is never committed.
# =====================================================================

# --- General -----------------------------------------------------------
# "production" disables the interactive API docs (/api/docs).
ENVIRONMENT=production
COMPANY_NAME=FleetRent Car Rental
CURRENCY=EUR
TAX_RATE=0.20

# --- Public access (nginx) ---------------------------------------------
# Hostname users type in the browser (used for TLS certificate + host check)
PUBLIC_HOSTNAME=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
# Comma-separated list of hostnames the API accepts
ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed if the frontend is served from a different origin (normally empty)
CORS_ORIGINS=

# --- Database ------------------------------------------------------------
POSTGRES_DB=fleetrent
POSTGRES_USER=fleetrent
POSTGRES_PASSWORD=CHANGE_ME

# --- Authentication --------------------------------------------------------
# At least 32 random characters. generate-env.sh creates a 64-byte value.
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
ALLOW_SELF_REGISTRATION=true

# --- First administrator (created on first start only) ---------------------
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE_ME

# --- Demo data (branches, cars, customers) ---------------------------------
SEED_DEMO_DATA=true
